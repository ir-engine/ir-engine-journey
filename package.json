{
  "name": "@ir-engine/ir-engine-journey",
  "version": "0.0.0",
  "description": "Tutorial website for learning iR Engine",
  "main": "",
  "scripts": {
    "test": "exit 0",
    "check-errors": "tsc --noemit",
    "dev": "cross-env APP_ENV=development NODE_OPTIONS=--max_old_space_size=20480 vite",
    "build": "cross-env NODE_OPTIONS=--max_old_space_size=10240 vite build",
    "start": "ts-node server.js",
    "format": "prettier --write \"**/*.{ts,tsx}\"",
    "format-scss": "stylelint \"**/*.scss\" --fix",
    "format-staged": "lint-staged",
    "local": "npm run localbuild && npm run localstart",
    "localbuild": "cross-env APP_ENV=production VITE_LOCAL_BUILD=true npm run build",
    "localstart": "cross-env APP_ENV=production VITE_LOCAL_BUILD=true npm run start"
  },
  "peerDependencies": {},
  "dependencies": {
    "@ir-engine/client": "1.6.0",
    "@ir-engine/ecs": "1.6.0",
    "@ir-engine/hyperflux": "1.6.0",
    "@ir-engine/spatial": "1.6.0",
    "react": "18.2.0",
    "react-dom": "18.2.0",
    "react-router-dom": "6.9.0",
    "react-syntax-highlighter": "15.6.1",
    "three": "0.158.0"
  },
  "devDependencies": {
    "@tailwindcss/typography": "^0.5.16",
    "@types/react": "18.2.0",
    "@types/react-dom": "18.2.0",
    "@types/react-syntax-highlighter": "15.5.13",
    "@types/three": "^0.158.0",
    "autoprefixer": "^10.4.14",
    "cross-env": "7.0.3",
    "postcss": "^8.4.23",
    "prettier": "3.0.2",
    "tailwindcss": "^3.3.2",
    "ts-node": "^10.9.1",
    "typescript": "5.6.3",
    "vite": "5.4.8"
  },
  "license": "ISC",
  "pre-commit": [
    "format-staged"
  ],
  "lint-staged": {
    "*.{ts,tsx}": [
      "prettier --write \"**/*.{ts,tsx}\""
    ],
    "*.scss": [
      "stylelint \"**/*.scss\" --fix"
    ]
  }
}
